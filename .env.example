# Copie este arquivo para .env e ajuste os valores. Nunca commite o .env real.

# --- Banco de dados ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marketing_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/marketing_platform

# --- API (FastAPI) ---
ENV=development
JWT_SECRET_KEY=troque-esta-chave-antes-de-qualquer-uso-real
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false
API_PORT=8000

# E-mail transacional (RF-001 — confirmação de conta, reset de senha,
# criação de conta por admin). Deixe RESEND_API_KEY em branco pra manter o
# comportamento de hoje (dev_token na resposta, nenhum e-mail de verdade
# enviado) — ver docs/security/AUTHENTICATION.md.
RESEND_API_KEY=
EMAIL_FROM=Lucratix <onboarding@resend.dev>
FRONTEND_BASE_URL=http://localhost:3000

# Logotipo de empresa (RF — gestão de empresas, ver docs/organizations/).
# Deixe as 3 variáveis em branco pra manter o comportamento de hoje (upload
# desabilitado, 503 "armazenamento não configurado") — ver core/storage.py.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000
# URL publica do proprio site — usada para resolver URLs absolutas de
# imagens de Open Graph/Twitter (og:image). Em producao (Vercel), defina
# como a URL real do deploy (ex.: https://lucratix.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
